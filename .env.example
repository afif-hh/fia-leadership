# Copy to .env for local development. .env is gitignored; this file is not.
# Nothing here is a real credential.

# Local SQLite file. drizzle-kit and the seed scripts read this one.
TURSO_DATABASE_URL=file:./.data/dev.db

# Nuxt runtimeConfig overrides. NUXT_ prefixed names map onto nuxt.config.ts:
#   NUXT_BETTER_AUTH_SECRET      -> runtimeConfig.betterAuthSecret
#   NUXT_TURSO_DATABASE_URL      -> runtimeConfig.tursoDatabaseUrl
#   NUXT_TURSO_AUTH_TOKEN        -> runtimeConfig.tursoAuthToken
#   NUXT_PUBLIC_BETTER_AUTH_URL  -> runtimeConfig.public.betterAuthUrl
#
# These four names are also what `wrangler secret put` must use on the deployed Worker. The
# prefix is the whole mechanism: an unprefixed BETTER_AUTH_SECRET or TURSO_DATABASE_URL maps
# onto nothing, runtimeConfig keeps its '' default, and every request fails with
# `URL_INVALID: The URL '' is not in a valid format` — a silent 500, not a startup error.
# The unprefixed TURSO_* pair below is separate: those are read directly from process.env by
# the Node scripts (drizzle-kit, db:migrate, db:seed), which never see runtimeConfig.
NUXT_BETTER_AUTH_SECRET=change-me-locally-at-least-32-characters
NUXT_TURSO_DATABASE_URL=file:./.data/dev.db
NUXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Only read by `pnpm db:reset` and `pnpm db:seed`. There is deliberately no default
# password anywhere in the repo: a seeded default admin credential is how platforms
# get owned. Minimum 12 characters, matching minPasswordLength.
LAB_ADMIN_EMAIL=labadmin@example.test
LAB_ADMIN_PASSWORD=change-me-locally-12-chars-min

# Deployed only. Never a real value in this file.
# NUXT_TURSO_AUTH_TOKEN=
